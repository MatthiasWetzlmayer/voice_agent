# Alles läuft lokal, kein API-Key nötig.

# Agenten über Ollama (Server-Adresse über OLLAMA_HOST, Standard localhost:11434).
# Für 16 GB RAM: ein Modell für beide, dann hält Ollama nur eines im Speicher.
VOICE_MODEL=ollama:qwen3:4b
TASK_MODEL=ollama:qwen3:4b

# Spracherkennung (faster-whisper über RealtimeSTT): fertiger Text / Live-Mitschrift
STT_MODEL=small
STT_REALTIME_MODEL=tiny

# Sprachausgabe (Piper), wird beim ersten Start nach ./voices geladen
PIPER_VOICE=de_DE-thorsten-medium
