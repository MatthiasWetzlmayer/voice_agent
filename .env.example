# OpenAI-Zugang (für Voice-Modell, Task-Modell, STT und TTS)
OPENAI_API_KEY=sk-...

# Modelle im Format "anbieter:modell" (siehe langchain init_chat_model)
VOICE_MODEL=openai:gpt-5-mini
TASK_MODEL=openai:gpt-5-mini
# Optional: schnellere Antworten des Voice-Agenten bei Reasoning-Modellen (z.B. minimal, low)
VOICE_REASONING_EFFORT=low

# Anthropic / Gemini als Alternative (Extras: uv sync --extra anthropic / --extra google)
# VOICE_MODEL=anthropic:claude-haiku-5-5
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...

# Spracherkennung und Sprachausgabe
STT_MODEL=gpt-4o-mini-transcribe
STT_LANGUAGE=de
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# TTS_INSTRUCTIONS=Sprich freundlich, natürlich und zügig auf Deutsch.

LOG_LEVEL=INFO
